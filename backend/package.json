{
	"name": "financy-backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm build && concurrently -k -n TS,API \"tsc -p tsconfig.build.json --watch\" \"node --watch dist/server.js\"",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:unit": "vitest run tests/unit.test.ts",
		"test:integration": "DATABASE_URL=file:./integration-test.db prisma migrate deploy && pnpm build && DATABASE_URL=file:./integration-test.db vitest run tests/graphql.integration.test.ts",
		"typecheck": "tsc --noEmit",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:seed": "tsx prisma/seed.ts",
		"format": "biome format --write .",
		"lint": "biome check .",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@prisma/client": "^6.19.3",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"dotenv": "^18.0.8",
		"express": "^5.3.0",
		"graphql": "^16.11.0",
		"jsonwebtoken": "^9.0.3",
		"reflect-metadata": "^0.2.2",
		"type-graphql": "2.0.0-rc.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bcryptjs": "^3.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.5",
		"concurrently": "^10.0.6",
		"prisma": "^6.19.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
